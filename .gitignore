# Root gitignore

# Dependencies
node_modules/
*/node_modules/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.env

# Uploaded Files & Binary Samples
backend/src/uploads/*
!backend/src/uploads/.gitkeep
uploads/
*.exe
*.dll
*.sys

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Build Outputs & Next.js
frontend/.next/
frontend/out/
build/
dist/

# OS / IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
